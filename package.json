{
  "name": "biochem-revision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Biochemistry revision app for veterinary students",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\" && vitest run",
    "check": "node scripts/check-content.ts",
    "review": "node scripts/render-review.ts",
    "demo": "node scripts/build-demo.ts",
    "test:logic": "node --test \"test/**/*.test.ts\"",
    "test:ui": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
